# TransLay self-hosted runtime example.
# Copy this file to a local .env file and replace every placeholder.
# Never commit real .env files, OAuth client secrets, service account keys, or database dumps.

# Shared service settings
NODE_ENV=development
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=us-central1
SESSION_SECRET=change-me-to-a-random-string-with-at-least-32-characters

# PostgreSQL
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=translay
DB_USER=translay_app
DB_PASSWORD=change-me
DB_POOL_MAX=20

# Redis
REDIS_HOST=127.0.0.1
REDIS_PORT=6379

# Control plane
PORT=8080
PRODUCTION_DOMAIN=translay.example.com
WORKER_URL=
CLOUD_TASKS_AUDIENCE=
CLOUD_TASKS_INVOKER_SA=
CLOUD_TASKS_QUEUE_NAME=sample-translate
CLOUD_TASKS_LOCATION=us-central1
LANDING_GOOGLE_WEB_CLIENT_ID=
GOOGLE_ID_TOKEN_ALLOWED_AUDIENCES=
KMS_KEY_NAME=
INTERNAL_CRON_SECRET=
MAX_GLOBAL_INFLIGHT_JOBS=50
CONTROL_PLANE_DB_POOL_MAX=20

# Billing provider placeholders.
# Leave these empty unless you intentionally configure the commercial billing flow.
PADDLE_ENVIRONMENT=sandbox
PADDLE_CLIENT_TOKEN=
PADDLE_API_KEY=
PADDLE_WEBHOOK_SECRET=
PADDLE_PRICE_ID_PRO_MONTHLY=
PADDLE_PRICE_ID_PRO_YEARLY=
PADDLE_PRICE_ID_CREDITS_SLIDES=
PADDLE_PRICE_AMOUNT_PRO_MONTHLY_CENTS=999
PADDLE_PRICE_AMOUNT_PRO_YEARLY_CENTS=11999
PADDLE_PRICE_AMOUNT_CREDITS_SLIDES_CENTS=4
PADDLE_MINIMUM_CHARGE_CENTS=70
PADDLE_WEBHOOK_TOLERANCE_SECONDS=300

# Worker
WORKER_PORT=8081
WORKER_DB_POOL_MAX=20
VERTEX_MODEL=gemini-3.1-flash-lite-preview
VERTEX_LOCATION=global
GEMMA_GPU_URL=
ALLOW_UNSIGNED_TASKS=false
DEBUG_CAPTURE_LLM_OUTPUTS=false
DEBUG_ALLOW_DEV_TEST_RAW_OUTPUT_PERSISTENCE=false
DEBUG_LLM_OUTPUT_RETENTION_HOURS=72

# Rate limits
RATE_LIMIT_GLOBAL_WINDOW_SECONDS=60
RATE_LIMIT_GLOBAL_MAX_REQUESTS=1200
RATE_LIMIT_USER_WRITE_WINDOW_SECONDS=60
RATE_LIMIT_USER_WRITE_MAX_REQUESTS=30
RATE_LIMIT_USER_READ_WINDOW_SECONDS=60
RATE_LIMIT_USER_READ_MAX_REQUESTS=120
